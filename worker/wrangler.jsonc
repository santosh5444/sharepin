{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sharepin-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "PIN_REGISTRY",
        "class_name": "PinRegistryDO"
      },
      {
        "name": "SESSION_DO",
        "class_name": "SessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["PinRegistryDO", "SessionDO"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
